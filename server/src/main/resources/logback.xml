<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss} %-5level %logger{20} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>
  <logger name="io.ktor" level="WARN" />
  <logger name="ktor.application" level="INFO" />
  <!-- Ktor 3 의 요청 기록(CallLogging) 이름 — io.ktor 를 WARN 으로 막아 둬서 따로 연다 -->
  <logger name="io.ktor.server.Application" level="INFO" />
</configuration>
